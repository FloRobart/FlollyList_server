{
  "name": "hollylist-api",
  "version": "1.3.2",
  "description": "HollyList est une application web qui permet de gérer facilement les cadeaux à offrir à ses proches.",
  "main": "src/server.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/server.ts",
    "dev-docker": "docker compose -f docker-compose.dev.yml up",
    "clean": "rm -rf dist",
    "clean-docker": "docker compose -f docker-compose.dev.yml down",
    "lint": "echo true",
    "format:check": "echo true",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FloRobart/hollylist-api.git"
  },
  "author": "FloRobart",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/FloRobart/hollylist-api/issues"
  },
  "homepage": "https://github.com/FloRobart/hollylist-api#readme",
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/morgan": "1.9.10",
    "@types/ms": "2.1.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "jest": "30.5.2",
    "nodemon": "3.1.14",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "axios": "1.21.0",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "morgan": "1.12.1",
    "ms": "2.1.3",
    "pg": "8.23.1",
    "zod": "4.6.7"
  }
}
