# Comments stay on their own line: after an empty value, Compose would read them as the value

# Application configuration
# Host (example: "localhost")
HOST_NAME=0.0.0.0
# Exposed port for HollyList API in development (example: 8080)
APP_PORT=26005
# URL where the API is available --> "http://${HOST_NAME}:${APP_PORT}"
BASE_URL="http://localhost:26005"
# Environment (dev, prod, silent) used to print more or less logs in console and expose Swagger endpoint
# prod when not set, so that a forgotten variable never exposes Swagger in production
APP_ENV=dev
# Format of the logs generated by morgan middleware (example: combined, common, dev, short, tiny)
LOG_FORMAT=combined

# Database
# Database scheme (postgresql, mysql, etc.)
DB_SCHEME=postgresql
# User for HollyList DB (same value as DB_USER in the hollylist-database repository)
# In production, hollylist-wrapper replaces it with hollylist_api: a role that can only read and write the rows of the tables
DB_USER=hollylist
# Hostname of the database service in Docker network
DB_HOST=hollylist-database
# Database name for HollyList DB
DB_NAME=hollylist

# Rate Limiting
# Number of requests allowed per second and per IP (example: 10)
REQUEST_LIMIT_PER_SECOND=10
# Time window to count requests in seconds (example: same value as JWT_EXPIRATION)
REQUEST_LIMIT_TIME=30min

# Authentication
# URL of the authentication application (Floraccess)
AUTH_APP_URL="http://localhost:26001"

# CORS
# List of allowed domains to make requests to the API (separated by commas)
CORS_ALLOWED_ORIGINS="http://localhost:26006"

# Secret, development only. Commented out so it never reaches a production .env:
# production reads it from a file (see docker-compose.yml).
# In development, docker-compose.dev.yml gives DB_PASSWORD a default value.
# DB_PASSWORD=postgres
